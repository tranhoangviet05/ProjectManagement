# ── Backend API ─────────────────────────────────────────────
# Điện thoại thật: dùng IP LAN của máy chạy Laravel (xem bằng lệnh ipconfig)
# Android Emulator: http://10.0.2.2:8000/api/v1
# iOS Simulator: http://localhost:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://YOUR_LAN_IP:8000/api/v1

# ── Cloudinary ──────────────────────────────────────────────
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── Laravel Reverb (WebSocket) ──────────────────────────────
EXPO_PUBLIC_REVERB_APP_KEY=
EXPO_PUBLIC_REVERB_HOST=YOUR_LAN_IP
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=http

# ── Firebase ────────────────────────────────────────────────
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ── Đăng nhập Google ────────────────────────────────────────
# Web client ID: Firebase Console -> Authentication -> Sign-in method -> Google -> Web SDK configuration
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Chỉ cần khi dùng expo-auth-session và build cho từng nền tảng
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=